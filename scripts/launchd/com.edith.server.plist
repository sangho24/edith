<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PR #18 — Edith server.py 부팅 시 자동 시작 (LaunchAgent).

  설치:
    bash scripts/launchd/install.sh install

  중지:
    bash scripts/launchd/install.sh uninstall

  상태:
    launchctl list | grep edith
    tail -f harness/server.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edith.server</string>

    <!-- uv run uvicorn harness.server:app -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--directory</string>
        <string>/Users/sangho/edith</string>
        <string>uvicorn</string>
        <string>harness.server:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8765</string>
    </array>

    <!-- .env 는 server.py 가 dotenv 로 자동 로드.
         그래도 PATH 등은 명시적으로 설정. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/sangho/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>EDITH_HOME</key>
        <string>/Users/sangho/edith</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/sangho/edith</string>

    <!-- 부팅 시 즉시 시작 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 죽으면 자동 재시작 (10초 간격) -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- stdout/stderr 로그 -->
    <key>StandardOutPath</key>
    <string>/Users/sangho/edith/harness/server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/sangho/edith/harness/server.err.log</string>
</dict>
</plist>
