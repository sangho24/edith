# Edith — Phase 0 환경변수 템플릿
# 실제 .env 파일은 git에 commit 금지 (.gitignore 등록됨)
# 발급 받은 후 cp .env.example .env 하고 채울 것

# === LLM ===
ANTHROPIC_API_KEY=

# (선택) 한국 도메인 task용
# UPSTAGE_SOLAR_API_KEY=

# (선택) embedding용
# OPENAI_API_KEY=

# === Google (Phase 3 F2 Calendar / F3 Gmail) ===
# Google Cloud Console에서 OAuth client 생성 후 채울 것
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/google/callback

# === KakaoTalk (Phase 3 F1 Quick Capture / push) ===
# Kakao Developers에서 앱 등록 후 채울 것
KAKAO_REST_API_KEY=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/kakao/callback

# === GitHub (Phase 3 F7 Repo Skill) ===
GITHUB_PAT=

# === Naver (선택, Phase 3 F1+) ===
# NAVER_MAIL_IMAP_PASSWORD=
# NAVER_SEARCH_CLIENT_ID=
# NAVER_SEARCH_CLIENT_SECRET=

# === Notion (선택) ===
# NOTION_INTEGRATION_TOKEN=

# === Local ===
EDITH_HOME=/Users/sangho/edith
EDITH_DB_PATH=/Users/sangho/edith/personal.db
EDITH_LOG_LEVEL=info
